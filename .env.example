# Server
# All values below have safe LOCAL DEFAULTS hardcoded in server/src/config/env.ts.
# You only need to set these when NODE_ENV=production OR when overriding a default.
NODE_ENV=development
PORT=4000
# Local default: mongodb://127.0.0.1:27017/studypartner
MONGO_URI=mongodb+srv://USER:PASS@CLUSTER/studypartner?retryWrites=true&w=majority
# Local default: a fixed dev secret (REQUIRED in production, no default)
SESSION_SECRET=replace-with-32-byte-random-string
# Local default: http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
BCRYPT_COST=12

# Client (Vite -- only VITE_-prefixed vars are exposed to the browser bundle)
VITE_APP_NAME=StudyPartner
